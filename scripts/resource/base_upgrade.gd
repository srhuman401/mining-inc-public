class_name GameBaseUpgrade extends Resource

@export var resource_requirements: Dictionary[GameEnum.ResourceType, int] = {}
@export var required_flags: Array[String] = []

## Use this to list requirements of flags (since they are not autogenerated),
## Will appear after autogenerated resource requirements
## NOTE: USE 'extra_requirement_info' INSTEAD. IT ALLOWS FULL CONTROL!
@export var extra_requirement_text: Array[String] = []
## Use this to list requirements of flags (since they are not autogenerated),
## Will appear after autogenerated resource requirements
@export var extra_requirement_info: Array[ExtraUpgradeInfo] = []

## NOTE: This does not reward them, it is only for visuals. 
@export var shown_item_unlocks: Array[String] = [] 

## Amount of fog to remove on width / viewable space to reward.
@export var remove_fog_width: int = 0
@export var remove_fog_height: int = 0

## Set this to true for `set_pickaxe_to`, to work
@export var do_set_pickaxe: bool = false
## Wont work unless `do_set_pickaxe` is `true`
@export var set_pickaxe_to: GameEnum.PickaxeType = GameEnum.PickaxeType.MAKESHIFT

@export var modifiers: Array[GameUpgradeModiferBase] = []
